{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://certificate-practice.local/schema/certificate-bank.schema.json",
  "title": "Certificate question and solution bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions", "solutions"],
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "solutions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/solution"
      }
    }
  },
  "$defs": {
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": {
              "const": "paragraph"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": {
              "const": "heading"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "level": {
              "enum": [3, 4]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "items"],
          "properties": {
            "kind": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "ordered": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "caption", "headers", "rows"],
          "properties": {
            "kind": {
              "const": "table"
            },
            "caption": {
              "type": "string",
              "minLength": 1
            },
            "headers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "language", "text"],
          "properties": {
            "kind": {
              "const": "code"
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": {
              "const": "formula"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "accessibleText": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "src", "alt"],
          "properties": {
            "kind": {
              "const": "image"
            },
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "src", "label"],
          "properties": {
            "kind": {
              "const": "audio"
            },
            "src": {
              "type": "string",
              "pattern": "^/audio/"
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contentBlock"
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-E]$"
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version", "locator"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "language",
        "stem",
        "options",
        "interaction",
        "classification",
        "shuffleOptions",
        "provenance",
        "verification",
        "certificateId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "variant": {
          "enum": ["A", "B"]
        },
        "language": {
          "const": "en"
        },
        "stem": {
          "$ref": "#/$defs/content"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "requiredSelections"],
          "properties": {
            "kind": {
              "enum": ["singleChoice", "multiSelect"]
            },
            "requiredSelections": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["section", "styleTags"],
          "properties": {
            "chapter": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "section": {
              "type": "string",
              "minLength": 1
            },
            "learningObjective": {
              "type": "string",
              "minLength": 1
            },
            "blueprintBucket": {
              "type": "string",
              "minLength": 1
            },
            "kLevel": {
              "enum": ["K1", "K2", "K3"]
            },
            "styleTags": {
              "type": "array",
              "minItems": 0,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "directKnowledge",
                  "scenario",
                  "statementEvaluation",
                  "calculation",
                  "ordering",
                  "tableOrDiagram",
                  "TRUE",
                  "FALSE",
                  "BEST",
                  "MOST",
                  "NOT",
                  "MINIMAL"
                ]
              }
            }
          }
        },
        "shuffleOptions": {
          "type": "boolean"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "authoringNote", "rightsStatus"],
          "properties": {
            "kind": {
              "enum": ["original", "sourceExcerpt"]
            },
            "authoringNote": {
              "type": "string",
              "minLength": 20
            },
            "rightsStatus": {
              "enum": ["cleared", "privateUserProvided"]
            },
            "sourceDocument": {
              "type": "string",
              "minLength": 1
            },
            "sourceQuestionNumber": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["answerStatus", "reviewedAgainst", "reviewedAt"],
          "properties": {
            "answerStatus": {
              "enum": ["verified", "sourcePrinted", "sourceAnomalyCorrected"]
            },
            "reviewedAgainst": {
              "type": "string",
              "minLength": 1
            },
            "reviewedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "certificateId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "formId": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "stimulus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "content"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "$ref": "#/$defs/content"
            }
          }
        }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctOptionIds", "explanation", "references", "questionId"],
      "properties": {
        "correctOptionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-E]$"
          }
        },
        "explanation": {
          "$ref": "#/$defs/content"
        },
        "optionRationales": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-E]$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/content"
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "questionId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
