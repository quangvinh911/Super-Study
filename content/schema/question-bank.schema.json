{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ctfl-practice.local/schema/question-bank.schema.json",
  "title": "CTFL chapter authoring file",
  "type": "object",
  "additionalProperties": false,
  "required": ["chapter", "questions"],
  "properties": {
    "chapter": { "type": "integer", "minimum": 1, "maximum": 6 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "paragraph" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "heading" },
            "text": { "type": "string", "minLength": 1 },
            "level": { "enum": [3, 4] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "items"],
          "properties": {
            "kind": { "const": "list" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "caption", "headers", "rows"],
          "properties": {
            "kind": { "const": "table" },
            "caption": { "type": "string", "minLength": 1 },
            "headers": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "language", "text"],
          "properties": {
            "kind": { "const": "code" },
            "language": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "formula" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "src", "alt"],
          "properties": {
            "kind": { "const": "image" },
            "src": { "type": "string", "minLength": 1 },
            "alt": { "type": "string", "minLength": 1 },
            "caption": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contentBlock" }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-E]$" },
        "content": { "$ref": "#/$defs/content" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version", "locator", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "const": "4.0.1" },
        "locator": { "type": "string", "pattern": "^FL-[1-6]\\.[0-9]+\\.[0-9]+$" },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "variant",
        "language",
        "stem",
        "options",
        "interaction",
        "classification",
        "shuffleOptions",
        "provenance",
        "verification",
        "solution"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^CTFL-C[1-6]-K[1-3]-[0-9]{2}-[AB]$" },
        "revision": { "type": "integer", "minimum": 1 },
        "variant": { "enum": ["A", "B"] },
        "language": { "const": "en" },
        "stem": { "$ref": "#/$defs/content" },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/option" }
        },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "requiredSelections"],
          "properties": {
            "kind": { "enum": ["singleChoice", "multiSelect"] },
            "requiredSelections": { "type": "integer", "minimum": 1, "maximum": 4 }
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chapter", "section", "learningObjective", "blueprintBucket", "kLevel", "styleTags"],
          "properties": {
            "chapter": { "type": "integer", "minimum": 1, "maximum": 6 },
            "section": { "type": "string", "minLength": 1 },
            "learningObjective": { "type": "string", "pattern": "^FL-[1-6]\\.[0-9]+\\.[0-9]+$" },
            "blueprintBucket": { "type": "string", "pattern": "^C[1-6]-K[1-3]-[0-9]{2}$" },
            "kLevel": { "enum": ["K1", "K2", "K3"] },
            "styleTags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "directKnowledge",
                  "scenario",
                  "statementEvaluation",
                  "calculation",
                  "ordering",
                  "tableOrDiagram",
                  "TRUE",
                  "FALSE",
                  "BEST",
                  "MOST",
                  "NOT",
                  "MINIMAL"
                ]
              }
            }
          }
        },
        "shuffleOptions": { "type": "boolean" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "authoringNote", "rightsStatus"],
          "properties": {
            "kind": { "const": "original" },
            "authoringNote": { "type": "string", "minLength": 20 },
            "rightsStatus": { "const": "cleared" }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["answerStatus", "reviewedAgainst", "reviewedAt", "reviewer"],
          "properties": {
            "answerStatus": { "const": "verified" },
            "reviewedAgainst": { "const": "ISTQB CTFL Syllabus v4.0.1" },
            "reviewedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "reviewer": { "type": "string", "minLength": 1 }
          }
        },
        "solution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["correctOptionIds", "explanation", "references"],
          "properties": {
            "correctOptionIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-E]$" }
            },
            "explanation": { "$ref": "#/$defs/content" },
            "optionRationales": {
              "type": "object",
              "propertyNames": { "pattern": "^[A-E]$" },
              "additionalProperties": { "$ref": "#/$defs/content" }
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/reference" }
            }
          }
        }
      }
    }
  }
}
